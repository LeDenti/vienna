# vienna — environment. Nothing here is secret; the demo creates and funds its own testnet wallets.
# XRPL websocket endpoint (default: testnet). Mainnet is NOT supported by the demo.
XRPL_URL=wss://s.altnet.rippletest.net:51233
# Dashboard port (bin/serve.mjs)
PORT=8790
# Secrets of the tranches live in state/*.secrets.json (git-ignored), demo wallet seeds in state/demo.wallets.json (git-ignored).
# Which ledger holds the deposit: xrpl (default) or casper. bin/vienna.mjs demo and the dashboard read it.
VIENNA_CHAIN=xrpl
# Casper testnet RPC (only with VIENNA_CHAIN=casper). Keys in state/demo.casper.wallets.json (git-ignored), contract in contracts/casper/deployment.json.
CASPER_RPC_URL=https://node.testnet.casper.network/rpc
